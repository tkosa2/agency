@page
@model AgencyCursor.WebApp.Pages.EmailLogs.IndexModel
@using AgencyCursor.WebApp.Helpers
@{
    ViewData["Title"] = "Email Logs";
}
<h1>Email Logs</h1>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Request</th><th>Interpreter</th><th>Sent At</th><th>Status</th><th>Error</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td><a asp-page="/Requests/Details" asp-route-id="@log.RequestId">#@log.RequestId</a></td>
                <td>@log.Interpreter.FullName</td>
                <td>@log.SentAt.ToString("MM/dd/yyyy HH:mm")</td>
                <td><span class="badge @StatusHelper.GetBadgeClass(log.Status)">@log.Status</span></td>
                <td>@log.ErrorMessage</td>
            </tr>
        }
    </tbody>
</table>
