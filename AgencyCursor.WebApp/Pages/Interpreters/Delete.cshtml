@page "{id:int}"
@model AgencyCursor.WebApp.Pages.Interpreters.DeleteModel
@{
    ViewData["Title"] = "Delete Interpreter";
}
<h1>Delete Interpreter</h1>
<div class="alert alert-danger">Are you sure you want to delete @Model.Interpreter.FullName?</div>
<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
