@page
@model AgencyCursor.WebApp.Pages.Interpreters.SearchDirectoryModel
@{
    ViewData["Title"] = "Search Interpreter Directory";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Search Interpreter Directory</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to Interpreters</a>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" placeholder="e.g. Alice" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" placeholder="e.g. Smith" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Certificate</label>
            <input asp-for="Certificate" class="form-control" placeholder="e.g. NIC" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Specialty</label>
            <input asp-for="Specialty" class="form-control" placeholder="e.g. Medical" />
        </div>
        <div class="col-md-4">
            <label class="form-label">City</label>
            <input asp-for="City" class="form-control" placeholder="e.g. Chicago" />
        </div>
        <div class="col-md-4">
            <label class="form-label">State</label>
            <input asp-for="State" class="form-control" placeholder="e.g. Illinois" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Zip Code</label>
            <input asp-for="Zip" class="form-control" placeholder="e.g. 60601" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="SearchDirectory" class="btn btn-outline-secondary ms-2">Clear</a>
    </div>
</form>

@if (Model.Searched)
{
    if (Model.Results.Count == 0)
    {
        <div class="alert alert-info">No interpreters found matching your criteria.</div>
    }
    else
    {
        <p class="text-muted">Found @Model.Results.Count result(s)@(Model.Results.Count == 100 ? " (showing first 100)" : "").</p>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Zip</th>
                        <th>Certificates</th>
                        <th>Specialties</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.Results)
                    {
                        <tr>
                            <td>@result.FullName</td>
                            <td>@result.City</td>
                            <td>@result.State</td>
                            <td>@result.ZipCode</td>
                            <td>@result.CertificatesSummary</td>
                            <td title="@result.SpecialtiesSummary">
                                @(result.Specialties.Count > 0
                                    ? (result.Specialties.Count == 1 ? result.Specialties[0] : $"{result.Specialties[0]} (+{result.Specialties.Count - 1} more)")
                                    : string.Empty)
                            </td>
                            <td>
                                <a asp-page="RegisterFromDirectory"
                                   asp-route-directoryId="@result.Id"
                                   asp-route-firstName="@Model.FirstName"
                                   asp-route-lastName="@Model.LastName"
                                   asp-route-certificate="@Model.Certificate"
                                   asp-route-specialty="@Model.Specialty"
                                   asp-route-city="@Model.City"
                                   asp-route-state="@Model.State"
                                   asp-route-zip="@Model.Zip"
                                   class="btn btn-sm btn-success">Register</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <p class="text-muted">Enter at least one filter to search the RID interpreter directory.</p>
}
