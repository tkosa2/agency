@page
@model AgencyCursor.WebApp.Pages.Interpreters.IndexModel
@{
    ViewData["Title"] = "Interpreters";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Interpreters</h1>
    <a asp-page="Create" class="btn btn-primary">Add Interpreter</a>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th><th>Email</th><th>Phone</th><th>Language</th><th>Certification</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.Interpreters)
        {
            <tr>
                <td>@i.FullName</td>
                <td>@i.Email</td>
                <td>@i.Phone</td>
                <td>@i.Language</td>
                <td>@i.Certification</td>
                <td>
                    <a asp-page="Details" asp-route-id="@i.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@i.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
