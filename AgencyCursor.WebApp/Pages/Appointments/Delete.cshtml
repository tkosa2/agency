@page "{id:int}"
@model AgencyCursor.WebApp.Pages.Appointments.DeleteModel
@{
    ViewData["Title"] = "Delete Appointment";
}
<h1>Delete Appointment #@Model.Appointment.Id</h1>
<div class="alert alert-danger">Are you sure you want to delete this appointment?</div>
<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
