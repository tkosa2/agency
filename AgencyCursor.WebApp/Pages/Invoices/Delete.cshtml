@page "{id:int}"
@model AgencyCursor.WebApp.Pages.Invoices.DeleteModel
@{
    ViewData["Title"] = "Delete Invoice";
}
<h1>Delete Invoice #@Model.Invoice.Id</h1>
<div class="alert alert-danger">Are you sure you want to delete this invoice?</div>
<p><strong>Amount:</strong> $@Model.Invoice.Amount.ToString("F2")</p>
<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
