@page "{id:int}"
@model AgencyCursor.WebApp.Pages.Requests.DeleteModel
@{
    ViewData["Title"] = "Delete Request";
}
<h1>Delete Request #@Model.Request.Id</h1>
<div class="alert alert-danger">Are you sure you want to delete this request?</div>
<p><strong>Requestor:</strong> @Model.Request.Requestor.FullName</p>
<p><strong>Date:</strong> @Model.Request.AppointmentDate.ToString("MM/dd/yyyy")</p>
<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
