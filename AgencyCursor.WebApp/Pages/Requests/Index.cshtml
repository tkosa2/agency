@page
@model AgencyCursor.WebApp.Pages.Requests.IndexModel
@using AgencyCursor.WebApp.Helpers
@{
    ViewData["Title"] = "Requests";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Requests</h1>
</div>
<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in new[] { "New Request","Reviewed","Approved","Broadcasted","Assigned","Confirmed","Completed","Cancelled<48h","Cancelled>48h" })
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
            </select>
        </div>
    </div>
</form>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Requestor</th>
            <th>Date</th>
            <th>Service</th>
            <th>Mode</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Requests)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Requestor.FullName</td>
                <td>@r.AppointmentDate.ToString("MM/dd/yyyy")</td>
                <td>@r.ServiceType</td>
                <td>@r.Mode</td>
                <td><span class="badge @StatusHelper.GetBadgeClass(r.Status)">@r.Status</span></td>
                <td>
                    <a asp-page="Details" asp-route-id="@r.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
