@page
@model AgencyCursor.WebApp.Pages.Request.IndexModel
@{
    ViewData["Title"] = "Submit Interpretation Request";
}
<h1>Submit Interpretation Request</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <h4 class="mt-4">Requestor Information</h4>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">First Name *</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Last Name *</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Email *</label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Phone *</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Notes</label>
        <textarea asp-for="RequestorNotes" class="form-control" rows="2"></textarea>
    </div>

    <h4 class="mt-4">Appointment Details</h4>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Appointment Date *</label>
            <input asp-for="AppointmentDate" class="form-control" type="date" />
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Start Time *</label>
            <input asp-for="StartTime" class="form-control" type="time" id="startTime" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">End Time *</label>
            <input asp-for="EndTime" class="form-control" type="time" id="endTime" />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Individual Type *</label>
            <select asp-for="IndividualType" class="form-select">
                <option value="">-- Select --</option>
                <option>Deaf</option>
                <option>Deaf-Blind</option>
            </select>
            <span asp-validation-for="IndividualType" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Number of Deaf Individuals</label>
            <input asp-for="NumberOfDeafIndividuals" class="form-control" type="number" min="1" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Service Type *</label>
            <select asp-for="ServiceType" class="form-select" id="serviceType">
                <option value="">-- Select --</option>
                <option>Medical</option>
                <option>Legal</option>
                <option>Educational</option>
                <option>Other</option>
            </select>
            <span asp-validation-for="ServiceType" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3" id="serviceTypeOtherDiv" style="display:none">
            <label class="form-label">Please Specify</label>
            <input asp-for="ServiceTypeOther" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Mode *</label>
        <select asp-for="Mode" class="form-select" id="modeSelect">
            <option value="">-- Select --</option>
            <option>In-Person</option>
            <option>Virtual</option>
        </select>
        <span asp-validation-for="Mode" class="text-danger"></span>
    </div>

    <div id="addressSection" style="display:none">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Address 2</label>
                <input asp-for="Address2" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">City</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">State</label>
                <input asp-for="State" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Zip Code</label>
                <input asp-for="ZipCode" class="form-control" />
            </div>
        </div>
    </div>

    <div id="virtualSection" style="display:none" class="mb-3">
        <label class="form-label">Virtual Meeting Link</label>
        <input asp-for="VirtualMeetingLink" class="form-control" />
    </div>

    <h4 class="mt-4">Preferences</h4>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Gender Preference</label>
            <select asp-for="GenderPreference" class="form-select">
                <option value="">No Preference</option>
                <option>Male</option>
                <option>Female</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Preferred Interpreter</label>
            <input asp-for="PreferredInterpreter" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Special Requirements</label>
        <textarea asp-for="SpecialRequirements" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Additional Information</label>
        <textarea asp-for="AdditionalInfo" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="AgreeToTerms" class="form-check-input" type="checkbox" />
        <label class="form-check-label">I agree to the terms and conditions *</label>
        <span asp-validation-for="AgreeToTerms" class="text-danger d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit Request</button>
    <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>

@section Scripts {
<script>
document.getElementById('startTime').addEventListener('change', function() {
    var start = this.value;
    if (start) {
        var parts = start.split(':');
        var h = parseInt(parts[0]) + 2;
        var m = parts[1];
        if (h >= 24) h = h - 24;
        document.getElementById('endTime').value = String(h).padStart(2,'0') + ':' + m;
    }
});
document.getElementById('modeSelect').addEventListener('change', function() {
    document.getElementById('addressSection').style.display = this.value === 'In-Person' ? 'block' : 'none';
    document.getElementById('virtualSection').style.display = this.value === 'Virtual' ? 'block' : 'none';
});
document.getElementById('serviceType').addEventListener('change', function() {
    document.getElementById('serviceTypeOtherDiv').style.display = this.value === 'Other' ? 'block' : 'none';
});
</script>
}
